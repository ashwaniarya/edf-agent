DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edf

# Public origin of this environment, no path (e.g. https://edf-dev.example.com).
# OAuth issuer = <origin>/api/auth; MCP resource (what users pass to `claude mcp add`) = <origin>/api/mcp.
# Optional for `next dev` (defaults to http://localhost:3000); required and https when REQUIRE_DB=true.
BETTER_AUTH_URL=http://localhost:3000

# 32+ random bytes, different in every environment: openssl rand -base64 32
# Optional for `next dev`; required for `npm start` and when REQUIRE_DB=true. Keep it stable: it encrypts the signing keys.
BETTER_AUTH_SECRET=

# true in deployed environments: requires DATABASE_URL, an https BETTER_AUTH_URL and a 32+ char secret.
REQUIRE_DB=

OPENROUTER_API_KEY=
